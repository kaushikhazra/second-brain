# Dev workspace — patterns for the development root, not the brain.
# The brain's own .gitignore lives at src/.gitignore.

# Distributable artifacts — the builder is committed, its output is not
dist/

# Spec-driven SDLC working artifacts
.claude/specs/

# Python bytecode
__pycache__/
*.pyc

# Linting cache
.ruff_cache/

# Temp — never check in
temp/
*temp*
.tmp/
