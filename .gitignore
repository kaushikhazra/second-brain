# Personal identity — lives only on the owner's machine, never in the repo
persona.md
user.md
*.bak

# Review and runtime artifacts
.claude/dryrun-*.md
.claude/eval.md
.claude/scheduled_tasks.lock

# Spec-driven SDLC working artifacts — internal, never shipped in this public repo
# (requirement.md, design.md, task.md, dryrun-*.md all live here)
.claude/specs/

# Distributable artifacts — the builder is committed, its output is not
dist/

# Temp — never check in
temp/
*temp*
.tmp/

# Python bytecode
__pycache__/
*.pyc

# Self-contained synaptra runtime (machine-specific, huge — never commit)
.claude/.python/
.claude/.venv/
.claude/uv*.exe
.claude/synaptra-data/
.claude/.self-aware
.mcp.json

# local-agent machine state — interpreter path, ollama host, model choice.
# Generated by `run.py --configure`; never committed.
.claude/skills/local-agent/config.json

# Isolated Claude config, created by brain-claude-sandbox.bat.
# Holds this machine's Claude settings and sign-in. Never committed.
.claude-config/
