{
  "extraKnownMarketplaces": {
    "apex-tools": {
      "source": {
        "source": "github",
        "repo": "kaushikhazra/apex"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__synaptra__memory_store|mcp__synaptra__memory_update|mcp__synaptra__memory_relate|mcp__synaptra__memory_archive|mcp__synaptra__memory_delete|mcp__synaptra__memory_unrelate",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_guard.sh\" memory_guard.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_guard.sh\" command_guard.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
