# Kept out of the distributable artifact — maintainer-only files.
# `git archive` honours export-ignore, so the dist can never contain them.
.gitattributes  export-ignore
tools/          export-ignore

# Development-only tests. A user never runs these and nothing in the skills
# invokes them; shipping them only invites "am I supposed to run these?".
# Pattern, not a list of names, so a NEW test file cannot silently start
# shipping. They stay in the repo — they just leave the dist.
.claude/skills/*/scripts/test_*.py  export-ignore

# Loop records. The development history of this brain — goal, observation,
# the instruction rewritten each cycle, and every cycle log. A user installing
# the brain is not installing our loops; a template that unpacks another
# project's working notes into someone's workspace is broken as a template.
.claude/loop/   export-ignore

# The loops' verification harnesses. `check_*.py` is what proved an acceptance
# criterion held; nothing in any skill invokes one at runtime, and they are
# referenced only from the cycle logs. Pattern, not a list, so a new check
# cannot silently start shipping.
#
# `verify_memory.py` is deliberately NOT matched here — session-end runs it as
# step 4, so it is runtime, not exhaust.
check_*.py      export-ignore

# The checks' shared scaffolding. `.claude/shared/` otherwise ships (that is where
# `activation.py` lives, which session-start imports at runtime), so a fixture module
# dropped in beside it would reach a user's install without this line. Pattern, not a
# list, so a new fixture cannot silently start shipping.
fixture_*.py    export-ignore
